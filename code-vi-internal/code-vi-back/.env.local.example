# Local test environment for CodeVi backend
# Copy this file to `.env.local` and adjust only if your local setup changes.

DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=codevi
DATABASE_USERNAME=root
DATABASE_PASSWORD=

JWT_SECRET=local-test-secret
JWT_EXPIRATION=36000000

SERVER_HOST=0.0.0.0
SERVER_PORT=13000

DEVELOP_FRONTEND_URL=http://localhost:5173
DEVELOP_INTERNAL_FRONTEND_URL=http://localhost:5174

PARSER_URL=http://localhost:3000/analyze
# Optional: explicitly override the source-code parser endpoint
# PARSER_SOURCE_URL=http://localhost:3000/analyze-source

# GitHub Repository 연동 — GitHub access token 암호화 키 (base64, 32byte). 아래 명령으로 생성:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GITHUB_TOKEN_ENC_KEY=

# 리팩토링 인사이트 AI 제안(NVIDIA NIM, OpenAI 호환 무료 API). build.nvidia.com에서 발급.
NVIDIA_API_KEY=
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
