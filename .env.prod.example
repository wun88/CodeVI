# 서버 배포용 환경변수
# 사용법: cp .env.prod.example .env.prod
# .env.prod 는 절대 커밋하지 말 것 (.gitignore에 포함됨)

# Jenkins 관리자 계정
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=강력한_비밀번호

# GitHub 자격증명 (Jenkins가 레포에 접근할 때 사용)
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# Jenkins 외부 URL (Cloudflare 터널 URL — GitHub webhook이 이 주소로 요청을 보냄)
# 도메인 설정 후 실제 URL로 교체
JENKINS_EXTERNAL_URL=https://jenkins.yourdomain.com/

# Cloudflare Tunnel 토큰
# 발급 방법: Cloudflare 대시보드 → Zero Trust → Networks → Tunnels → 터널 생성 → 토큰 복사
CLOUDFLARE_TUNNEL_TOKEN=eyJhxxxxxxxxxxxxxxxx
