# 로컬 개발 환경변수
# 사용법: cp .env.local.example .env.local
# .env.local 은 gitignore에 있음 — 절대 커밋하지 말 것

# Jenkins 관리자 계정
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=admin123

# GitHub 자격증명 (Jenkins가 사용자 레포에 접근할 때 사용)
# GitHub Settings > Developer settings > Personal access tokens 에서 발급
# 필요 권한: repo, admin:repo_hook
GITHUB_USERNAME=your-github-username
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# MySQL (Docker 이미지가 직접 읽는 변수명)
MYSQL_DATABASE=codevi
MYSQL_USER=refactory
MYSQL_PASSWORD=devpassword
MYSQL_ROOT_PASSWORD=rootpassword
